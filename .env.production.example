# Copy to .env.production and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

APP_VERSION=1.0.0
# Public HTTPS address of the web app (used in emails and to check request origins).
# Multi-clinic hosting: the bare domain, e.g. https://nextcore.net.au (clinic links become https://<clinic>.nextcore.net.au)
APP_URL=https://clinic.example.com
POSTGRES_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# Behind an HTTPS reverse proxy: secure cookies and trust one proxy hop for client IPs.
COOKIE_SECURE=true
TRUST_PROXY=1
# Public self-registration of new organisations (off for a single clinic deployment).
ALLOW_SIGNUP=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168

# Outgoing email (required for invitations, password resets, reminders, referral letters)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Your Clinic <no-reply@clinic.example.com>"

# Multi-clinic hosting. Empty: a single installation. Set (e.g. nextcore.net.au) to give every clinic its own
# database and address <clinic>.BASE_DOMAIN; the super admin works at PLATFORM_SUBDOMAIN.BASE_DOMAIN.
# Needs wildcard DNS and a wildcard TLS certificate for *.BASE_DOMAIN, and DB_NAME=vcms_platform for a new install.
# Changing BASE_DOMAIN or PLATFORM_SUBDOMAIN requires rebuilding the web image.
BASE_DOMAIN=
PLATFORM_SUBDOMAIN=admin
# Database the API connects to: the clinic database (single installation) or the platform database.
DB_NAME=vcms

MAX_UPLOAD_MB=20
LOG_FORMAT=json
API_DOCS=false
CLIENT_PORTAL_ENABLED=false

# Web port published on the host (bind to 127.0.0.1 when a reverse proxy runs on the same host)
WEB_BIND=127.0.0.1
WEB_PORT=3000
