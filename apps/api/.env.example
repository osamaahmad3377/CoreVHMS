# --- Runtime ---
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails and allowed origins)
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://vcms:vcms_dev_password@localhost:5433/vcms?schema=public

# --- Security ---
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Encrypts MFA secrets and integration credentials at rest (32 bytes hex)
ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=168
COOKIE_SECURE=false

# --- Email (Mailpit in development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NextCore VCMS <no-reply@nextcore.local>"

# --- File storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=20

# --- Optional features ---
# Client portal (client-facing website). Kept switched off for now; to turn it on later set this to true
# here AND in the web app's environment (CLIENT_PORTAL_ENABLED=true npm run dev -w @vcms/web), then reseed.
CLIENT_PORTAL_ENABLED=false

# --- Multi-clinic hosting (optional) ---
# Leave BASE_DOMAIN empty for one installation serving the clinics in DATABASE_URL.
# Set it to host many clinics, each with its own database, at <clinic>.BASE_DOMAIN. DATABASE_URL then points
# at the platform database (the list of clinics and super admins), and clinic databases are created next to it.
# Locally: BASE_DOMAIN=localhost, DATABASE_URL=…/vcms_platform, then open http://admin.localhost:3000.
# Set the same BASE_DOMAIN for the web app (BASE_DOMAIN=localhost npm run dev -w @vcms/web).
BASE_DOMAIN=
PLATFORM_SUBDOMAIN=admin
TENANT_DB_PREFIX=vcms_t_
TENANT_DB_POOL=5
