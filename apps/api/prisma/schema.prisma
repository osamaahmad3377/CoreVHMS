model ReferralContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  practice       String?
  specialty      String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  referrals    Referral[]

  @@index([organizationId, name])
}

model Referral {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  number          Int
  direction       ReferralDirection
  patientId       String            @db.Uuid
  clientId        String            @db.Uuid
  contactId       String?           @db.Uuid
  externalVet     String?
  urgency         ReferralUrgency   @default(ROUTINE)
  reason          String
  clinicalSummary String?
  questions       String?
  status          ReferralStatus    @default(DRAFT)
  sentAt          DateTime?         @db.Timestamptz(3)
  sentByName      String?
  acceptedAt      DateTime?         @db.Timestamptz(3)
  appointmentAt   DateTime?         @db.Timestamptz(3)
  completedAt     DateTime?         @db.Timestamptz(3)
  outcome         String?
  declineReason   String?
  createdByName   String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact      ReferralContact? @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([patientId])
}

enum PurchaseRequestStatus {
  OPEN
  ORDERED
  REJECTED
  CANCELLED
}

/// A member of staff asks for a product to be ordered; procurement turns open requests into a draft purchase order.
model PurchaseRequest {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  branchId        String                @db.Uuid
  number          Int
  productId       String                @db.Uuid
  quantity        Decimal               @db.Decimal(14, 4)
  reason          String?
  neededBy        DateTime?             @db.Date
  status          PurchaseRequestStatus @default(OPEN)
  requestedById   String                @db.Uuid
  requestedByName String
  purchaseOrderId String?               @db.Uuid
  decidedById     String?               @db.Uuid
  decidedByName   String?
  decidedAt       DateTime?             @db.Timestamptz(3)
  decisionNote    String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// Stock sent back to the supplier (damaged, recalled, short-dated, wrong item). Append-only (DB trigger):
/// it takes the batch out of stock at its cost and reduces the amount owed to the supplier.
model SupplierReturn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  number         Int
  supplierId     String   @db.Uuid
  locationId     String   @db.Uuid
  reason         String
  reference      String?
  totalMinor     Int
  createdById    String   @db.Uuid
  createdByName  String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines        SupplierReturnLine[]

  @@unique([organizationId, number])
  @@index([organizationId, supplierId])
}

model SupplierReturnLine {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  supplierReturnId String  @db.Uuid
  productId        String  @db.Uuid
  batchId          String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 4)
  unitCostMinor    Int
  totalMinor       Int

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          StockBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([supplierReturnId])
}

enum ReceiptLogoSource {
  BRANDING
  CUSTOM
}

enum ReceiptAlign {
  LEFT
  CENTER
  RIGHT
}

enum ReceiptFontSize {
  SMALL
  NORMAL
  LARGE
}

/// How counter and payment receipts are printed (one row per organization; defaults apply until saved).
model ReceiptSettings {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @unique @db.Uuid
  /// Roll width: 80 mm (standard) or 58 mm.
  paperWidthMm           Int               @default(80)
  /// Blank space left and right, for printers that cannot print to the edge.
  sideMarginMm           Int               @default(3)
  fontSize               ReceiptFontSize   @default(NORMAL)
  showLogo               Boolean           @default(true)
  logoSource             ReceiptLogoSource @default(BRANDING)
  customLogoAttachmentId String?           @db.Uuid
  /// Logo width as a percentage of the printable width.
  logoWidthPercent       Int               @default(55)
  logoAlign              ReceiptAlign      @default(CENTER)
  /// Black-and-white, high-contrast logo for thermal printers.
  logoMonochrome         Boolean           @default(true)
  title                  String            @default("TAX INVOICE / RECEIPT")
  headerText             String?
  footerText             String?           @default("Thank you for caring for your pet with us")
  policyText             String?
  showLegalName          Boolean           @default(true)
  showBranchAddress      Boolean           @default(true)
  showPhone              Boolean           @default(true)
  showEmail              Boolean           @default(false)
  showTaxNumber          Boolean           @default(true)
  showServedBy           Boolean           @default(true)
  showCustomer           Boolean           @default(true)
  showPatient            Boolean           @default(true)
  showItemCodes          Boolean           @default(false)
  showTaxLine            Boolean           @default(true)
  /// Open the print dialog automatically after each counter sale.
  autoPrint              Boolean           @default(false)
  copies                 Int               @default(1)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)
  updatedByName          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}
