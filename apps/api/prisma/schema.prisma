  @@unique([organizationId, number])
  @@index([organizationId, branchId, startDate, endDate])
  @@index([unitId, startDate])
  @@index([patientId])
}

/// Daily care log for boarders (feeding, walks, medication, incidents). Append-only.
model BoardingLog {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  stayId         String          @db.Uuid
  kind           BoardingLogKind
  text           String
  recordedAt     DateTime        @default(now()) @db.Timestamptz(3)
  recordedById   String?         @db.Uuid
  recordedByName String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stay         BoardingStay @relation(fields: [stayId], references: [id], onDelete: Restrict)

  @@index([stayId, recordedAt])
}

model GroomingJob {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  branchId       String         @db.Uuid
  number         Int
  patientId      String         @db.Uuid
  clientId       String         @db.Uuid
  appointmentId  String?        @unique @db.Uuid
  groomerId      String?        @db.Uuid
  status         GroomingStatus @default(WAITING)
  instructions   String?
  coatCondition  String?
  behaviour      String?
  groomerNotes   String?
  startedAt      DateTime?      @db.Timestamptz(3)
  readyAt        DateTime?      @db.Timestamptz(3)
  collectedAt    DateTime?      @db.Timestamptz(3)
  cancelledAt    DateTime?      @db.Timestamptz(3)
  cancelReason   String?
  createdByName  String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment  Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  groomer      Membership?          @relation("Groomer", fields: [groomerId], references: [id], onDelete: Restrict)
  services     GroomingJobService[]

  @@unique([organizationId, number])
  @@index([organizationId, branchId, createdAt])
  @@index([patientId])
}

model GroomingJobService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  jobId          String   @db.Uuid
  serviceId      String   @db.Uuid
  description    String
  priceMinor     Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job          GroomingJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([jobId])
}

