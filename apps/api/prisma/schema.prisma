model BoardingUnit {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  branchId         String           @db.Uuid
  name             String
  type             BoardingUnitType @default(KENNEL)
  nightlyServiceId String?          @db.Uuid
