model BoardingStay {
  id                     String         @id @default(uuid()) @db.Uuid
  organizationId         String         @db.Uuid
  branchId               String         @db.Uuid
  number                 Int
  patientId              String         @db.Uuid
  clientId               String         @db.Uuid
  unitId                 String?        @db.Uuid
  status                 BoardingStatus @default(RESERVED)
  startDate              DateTime       @db.Date
  endDate                DateTime       @db.Date
  nightlyRateMinor       Int            @default(0)
  nightlyServiceId       String?        @db.Uuid
  feedingInstructions    String?
  medicationInstructions String?
  belongings             String?
  behaviourNotes         String?
  emergencyContact       String?
  vaccinationOverride    String?
  checkedInAt            DateTime?      @db.Timestamptz(3)
  checkedInByName        String?
  checkedOutAt           DateTime?      @db.Timestamptz(3)
  checkedOutByName       String?
  nightsCharged          Int?
  cancelledAt            DateTime?      @db.Timestamptz(3)
  cancelReason           String?
  createdByName          String?
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
