  payments     Payment[]
  refunds      Refund[]
  expenses     Expense[]

  @@index([branchId, status])
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  date           DateTime      @db.Date
  category       String
  description    String
  amountMinor    Int
  taxMinor       Int           @default(0)
  supplierId     String?       @db.Uuid
  method         PaymentMethod
  reference      String?
  cashSessionId  String?       @db.Uuid
  createdById    String        @db.Uuid
  createdByName  String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([organizationId, date])
}

// ───────────────────────────── Hospitalisation (Milestone 6) ─────────────────────────────

enum WardType {
  GENERAL
  ICU
  ISOLATION
  CATTERY
  KENNEL
  LARGE_ANIMAL
  EXOTICS
  OTHER
}

/// A ward groups cages/kennels/stalls. The optional daily service is charged per started 24 hours of stay.
model Ward {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  type           WardType @default(GENERAL)
  dailyServiceId String?  @db.Uuid
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  dailyService Service?     @relation(fields: [dailyServiceId], references: [id], onDelete: SetNull)
  cages        Cage[]
  admissions   Admission[]

  @@unique([organizationId, branchId, name])
}

model Cage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  wardId         String   @db.Uuid
  name           String
  notes          String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ward         Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions   Admission[]

  @@unique([wardId, name])
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum AdmissionOutcome {
  DISCHARGED_HOME
  TRANSFERRED
  DECEASED
  EUTHANASED
}

enum PatientCondition {
  STABLE
  FAIR
  GUARDED
  CRITICAL
}

enum CprStatus {
  UNDECIDED
  CPR
  DNR
}

/// A hospital stay. One active admission per patient and per cage (partial unique indexes).
model Admission {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  branchId               String            @db.Uuid
  number                 Int
  patientId              String            @db.Uuid
  clientId               String            @db.Uuid
  encounterId            String?           @db.Uuid
  wardId                 String?           @db.Uuid
  cageId                 String?           @db.Uuid
  status                 AdmissionStatus   @default(ADMITTED)
  condition              PatientCondition  @default(STABLE)
  cprStatus              CprStatus         @default(UNDECIDED)
  reason                 String
  diagnosis              String?
  isolation              Boolean           @default(false)
  feedingInstructions    String?
  responsibleClinicianId String?           @db.Uuid
  expectedDischargeAt    DateTime?         @db.Timestamptz(3)
  admittedAt             DateTime          @default(now()) @db.Timestamptz(3)
  admittedById           String            @db.Uuid
  admittedByName         String
  dischargedAt           DateTime?         @db.Timestamptz(3)
  dischargedById         String?           @db.Uuid
  dischargedByName       String?
  outcome                AdmissionOutcome?
  dischargeSummary       String?
  homeCareInstructions   String?
  followUpAt             DateTime?         @db.Timestamptz(3)
  cancelReason           String?
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch               Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient              Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  ward                 Ward?            @relation(fields: [wardId], references: [id], onDelete: SetNull)
  cage                 Cage?            @relation(fields: [cageId], references: [id], onDelete: SetNull)
  responsibleClinician Membership?      @relation("AdmissionClinician", fields: [responsibleClinicianId], references: [id], onDelete: SetNull)
  orders               TreatmentOrder[]
  tasks                TreatmentTask[]
  notes                HospitalNote[]
  surgeries            Surgery[]

  @@unique([organizationId, number])
  @@index([organizationId, status, branchId])
  @@index([patientId, admittedAt(sort: Desc)])
}

enum TreatmentKind {
  MEDICATION
  FLUID
  FEEDING
  NURSING
  OBSERVATION
  OTHER
}

enum TreatmentSchedule {
  INTERVAL
  ONCE
  AS_NEEDED
  CONTINUOUS
}

enum TreatmentOrderStatus {
  ACTIVE
  STOPPED
  COMPLETED
}

/// A treatment-sheet order. Doses and rates are entered by the clinician; none are suggested by the system.
model TreatmentOrder {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  admissionId        String               @db.Uuid
  kind               TreatmentKind
  schedule           TreatmentSchedule    @default(INTERVAL)
  description        String
  productId          String?              @db.Uuid
  dose               Decimal?             @db.Decimal(14, 4)
  doseUnit           String?
  route              String?
  fluidRateMlPerHour Decimal?             @db.Decimal(10, 2)
  intervalHours      Int?
  instructions       String?
  startAt            DateTime             @db.Timestamptz(3)
  endAt              DateTime?            @db.Timestamptz(3)
  status             TreatmentOrderStatus @default(ACTIVE)
  orderedById        String               @db.Uuid
  orderedByName      String
  stoppedAt          DateTime?            @db.Timestamptz(3)
  stoppedByName      String?
  stopReason         String?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  admission    Admission       @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  tasks        TreatmentTask[]

  @@index([admissionId, status])
}

enum TreatmentTaskStatus {
  DUE
  DONE
  SKIPPED
  CANCELLED
}

/// One scheduled (or as-needed) occurrence of a treatment order, ticked off on the treatment sheet.
model TreatmentTask {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  admissionId      String              @db.Uuid
  orderId          String              @db.Uuid
  dueAt            DateTime            @db.Timestamptz(3)
  status           TreatmentTaskStatus @default(DUE)
  doneAt           DateTime?           @db.Timestamptz(3)
  doneById         String?             @db.Uuid
  doneByName       String?
  value            String?
  notes            String?
  skipReason       String?
  administrationId String?             @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  admission    Admission      @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  order        TreatmentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, dueAt])
  @@index([admissionId, dueAt])
  @@index([organizationId, status, dueAt])
}

enum HospitalNoteType {
  PROGRESS
  HANDOVER
  ALERT
}

/// Append-only progress, handover and escalation notes.
model HospitalNote {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  admissionId    String           @db.Uuid
  type           HospitalNoteType @default(PROGRESS)
  text           String
  authorId       String           @db.Uuid
  authorName     String
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  admission    Admission    @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@index([admissionId, createdAt])
}

// ───────────────────────────── Surgery & anaesthesia (Milestone 6) ─────────────────────────────

enum SurgeryStatus {
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  COMPLETED
  CANCELLED
}

enum SurgeryPriority {
  ELECTIVE
  URGENT
  EMERGENCY
}

enum AsaGrade {
  I
  II
  III
  IV
  V
}

/// Surgical case. Scheduling uses an Appointment (clinician + theatre overlap protection).
/// Once COMPLETED the record is locked by trigger; later corrections are addenda.
model Surgery {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  branchId           String          @db.Uuid
  number             Int
  patientId          String          @db.Uuid
  clientId           String          @db.Uuid
  appointmentId      String?         @unique @db.Uuid
  admissionId        String?         @db.Uuid
  encounterId        String?         @db.Uuid
  procedure          String
  serviceId          String?         @db.Uuid
  theatreId          String?         @db.Uuid
  scheduledAt        DateTime        @db.Timestamptz(3)
  durationMinutes    Int
  priority           SurgeryPriority @default(ELECTIVE)
  status             SurgeryStatus   @default(SCHEDULED)
  asaGrade           AsaGrade?
  asaEmergency       Boolean         @default(false)
  preOpAssessment    String?
  fastingConfirmed   Boolean         @default(false)
  consentObtained    Boolean         @default(false)
  consentGivenBy     String?
  consentAt          DateTime?       @db.Timestamptz(3)
  consentRecordedBy  String?
  estimateMinor      Int?
  checklist          Json            @default("[]")
  anaesthesiaPlan    String?
  airway             String?
  anaesthesiaStartAt DateTime?       @db.Timestamptz(3)
  anaesthesiaEndAt   DateTime?       @db.Timestamptz(3)
  startedAt          DateTime?       @db.Timestamptz(3)
  endedAt            DateTime?       @db.Timestamptz(3)
  recoveryStartedAt  DateTime?       @db.Timestamptz(3)
  completedAt        DateTime?       @db.Timestamptz(3)
  completedById      String?         @db.Uuid
  completedByName    String?
  surgicalNotes      String?
  findings           String?
  complications      String?
  postOpInstructions String?
  followUpAt         DateTime?       @db.Timestamptz(3)
  cancelledAt        DateTime?       @db.Timestamptz(3)
  cancelReason       String?
  createdById        String          @db.Uuid
  createdByName      String
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  admission    Admission?           @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  service      Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  theatre      Resource?            @relation(fields: [theatreId], references: [id], onDelete: SetNull)
  team         SurgeryTeamMember[]
  readings     AnaesthesiaReading[]
  items        SurgeryItem[]
  addenda      SurgeryAddendum[]

  @@unique([organizationId, number])
  @@index([organizationId, branchId, scheduledAt])
  @@index([patientId, scheduledAt(sort: Desc)])
}

enum SurgeryRole {
  SURGEON
  ASSISTANT
  ANAESTHETIST
  NURSE
  OTHER
}

model SurgeryTeamMember {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  surgeryId      String      @db.Uuid
  membershipId   String      @db.Uuid
  role           SurgeryRole

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  surgery      Surgery      @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  membership   Membership   @relation("SurgeryTeam", fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([surgeryId, membershipId, role])
}

enum ReadingPhase {
  INTRA_OP
  RECOVERY
}

/// Anaesthesia monitoring and recovery readings. Append-only (trigger); corrections are new readings.
model AnaesthesiaReading {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  surgeryId       String       @db.Uuid
  phase           ReadingPhase @default(INTRA_OP)
  recordedAt      DateTime     @default(now()) @db.Timestamptz(3)
  heartRate       Int?
  respiratoryRate Int?
  spo2            Int?
  etco2           Int?
  systolicBp      Int?
  diastolicBp     Int?
  meanBp          Int?
  temperatureC    Decimal?     @db.Decimal(4, 1)
  agentPercent    Decimal?     @db.Decimal(4, 2)
  oxygenLpm       Decimal?     @db.Decimal(5, 2)
  painScore       Int?
  notes           String?
  recordedById    String       @db.Uuid
  recordedByName  String
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  surgery      Surgery      @relation(fields: [surgeryId], references: [id], onDelete: Restrict)

  @@index([surgeryId, recordedAt])
}

/// Consumables and implants used during surgery: deducted from stock and charged once.
model SurgeryItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  surgeryId      String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Decimal  @db.Decimal(14, 4)
  notes          String?
  recordedByName String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  surgery      Surgery      @relation(fields: [surgeryId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([surgeryId])
}

model SurgeryAddendum {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  surgeryId      String   @db.Uuid
  text           String
  authorId       String   @db.Uuid
  authorName     String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  surgery      Surgery      @relation(fields: [surgeryId], references: [id], onDelete: Restrict)

  @@index([surgeryId])
}

enum ChecklistPhase {
  SIGN_IN
  TIME_OUT
  SIGN_OUT
}

/// Organisation's surgical safety checklist (procedural items; editable in settings).
model SurgeryChecklistItem {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  phase          ChecklistPhase
  label          String
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, phase])
}

// ───────────────────────────── Preventive care (Milestone 7) ─────────────────────────────

enum CareKind {
  VACCINATION
  DEWORMING
  PARASITE_PREVENTION
  HEALTH_CHECK
  DENTAL
  OTHER
}

enum CareProtocolStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// Configurable preventive-care schedule. Only APPROVED protocols (with a recorded source and reviewer)
/// generate care items; nothing is shipped as a default.
model CareProtocol {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  name             String
  kind             CareKind
  speciesId        String?            @db.Uuid
  productId        String?            @db.Uuid
  firstDueAgeWeeks Int?
  intervalDays     Int?
  source           String
  notes            String?
  status           CareProtocolStatus @default(DRAFT)
  reviewedByName   String?
  reviewedAt       DateTime?          @db.Timestamptz(3)
  createdByName    String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  species      Species?     @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  items        CareItem[]

  @@index([organizationId, status])
}

enum CareItemStatus {
  DUE
  COMPLETED
  CANCELLED
  DEFERRED
}

/// One entry in a patient's care plan (e.g. "Rabies booster due 1 Mar"). Completing a recurring item
/// schedules the next one.
model CareItem {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  patientId         String         @db.Uuid
  protocolId        String?        @db.Uuid
  kind              CareKind
  title             String
  dueDate           DateTime       @db.Date
  status            CareItemStatus @default(DUE)
  deferredUntil     DateTime?      @db.Date
  deferReason       String?
  cancelReason      String?
  completedAt       DateTime?      @db.Timestamptz(3)
  completedByName   String?
  administrationId  String?        @unique @db.Uuid
  givenElsewhere    Boolean        @default(false)
  productName       String?
  batchNumber       String?
  notes             String?
  previousItemId    String?        @db.Uuid
  remindedAt        DateTime?      @db.Timestamptz(3)
  overdueRemindedAt DateTime?      @db.Timestamptz(3)
  createdByName     String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  protocol     CareProtocol? @relation(fields: [protocolId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([patientId, dueDate])
}

// ───────────────────────────── Communications (Milestone 7) ─────────────────────────────

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

/// Editable message wording per purpose and channel ({{placeholders}} are filled at send time).
model MessageTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  purpose        String
  channel        MessageChannel
  subject        String?
  body           String
  isActive       Boolean        @default(true)
  updatedByName  String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, purpose, channel])
}

/// Delivery log and queue for every outgoing client message. dedupeKey prevents duplicate notifications.
model OutboundMessage {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  clientId          String?        @db.Uuid
  patientId         String?        @db.Uuid
  channel           MessageChannel
  recipient         String
  subject           String?
  body              String
  purpose           String
  status            MessageStatus  @default(QUEUED)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @db.Timestamptz(3)
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?      @db.Timestamptz(3)
  dedupeKey         String?
  sourceType        String?
  sourceId          String?
  createdByName     String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, createdAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

/// Secure messages between a client (portal) and the clinic.
model ClientMessage {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  clientId       String           @db.Uuid
  patientId      String?          @db.Uuid
  direction      MessageDirection
  kind           String           @default("MESSAGE")
  subject        String?
  body           String
  authorName     String
  staffUserId    String?          @db.Uuid
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, direction, readAt])
}

// ───────────────────────────── Client portal (Milestone 7) ─────────────────────────────

enum PortalUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// A client's portal login. One login can be linked to client records at several clinics.
model PortalUser {
  id               String           @id @default(uuid()) @db.Uuid
  email            String           @unique
  name             String
  passwordHash     String?
  status           PortalUserStatus @default(INVITED)
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?        @db.Timestamptz(3)
  lastLoginAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  accesses PortalAccess[]
  sessions PortalSession[]
  tokens   PortalToken[]
}

model PortalAccess {
  id             String   @id @default(uuid()) @db.Uuid
  portalUserId   String   @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  isActive       Boolean  @default(true)
  invitedByName  String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  portalUser   PortalUser   @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, clientId])
  @@unique([portalUserId, organizationId])
}

model PortalSession {
  id           String    @id @default(uuid()) @db.Uuid
  portalUserId String    @db.Uuid
  accessId     String    @db.Uuid
  tokenHash    String    @unique
  csrfToken    String
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId])
}

enum PortalTokenType {
  INVITE
  RESET
}

model PortalToken {
  id           String          @id @default(uuid()) @db.Uuid
  portalUserId String          @db.Uuid
  type         PortalTokenType
  tokenHash    String          @unique
  expiresAt    DateTime        @db.Timestamptz(3)
  consumedAt   DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, type])
}

enum AppointmentRequestStatus {
  PENDING
  BOOKED
  DECLINED
  CANCELLED
}

/// Appointment requested by a client through the portal; staff book it into the calendar or decline.
model AppointmentRequest {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  clientId       String                   @db.Uuid
  patientId      String?                  @db.Uuid
  reason         String
  preferredDate  DateTime                 @db.Date
  preferredTime  String                   @default("ANY")
  notes          String?
  status         AppointmentRequestStatus @default(PENDING)
  appointmentId  String?                  @db.Uuid
  handledByName  String?
  handledAt      DateTime?                @db.Timestamptz(3)
  declineReason  String?
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
}

// ───────────────────────── Milestone 8: livestock & farms ─────────────────────────

enum FarmStatus {
  ACTIVE
  INACTIVE
}

enum AnimalGroupKind {
  HERD
  FLOCK
  PEN
  BATCH
}

enum ProductionPurpose {
  DAIRY
  BEEF
  BREEDING
  LAYER
  BROILER
  MEAT
  WOOL
  MIXED
  OTHER
}

enum AnimalGroupStatus {
  ACTIVE
  CLOSED
}

enum LivestockEventType {
  MOVE
  PURCHASE
  SALE
  TRANSFER
  DEATH
  CULL
  BIRTH
  PLACEMENT
}

enum BreedingEventType {
  HEAT
  SERVICE
  INSEMINATION
  PREGNANCY_CHECK
  BIRTH
  ABORTION
  DRY_OFF
}

enum PregnancyResult {
  PREGNANT
  NOT_PREGNANT
  INCONCLUSIVE
}

enum ProductionKind {
  MILK
  EGGS
  FEED
  BATCH_WEIGHT
  MORTALITY
  WATER
}

enum GroupTreatmentKind {
  VACCINATION
  PARASITE_CONTROL
  TREATMENT
  OTHER
}

enum OutbreakStatus {
  SUSPECTED
  CONFIRMED
  CONTROLLED
  CLOSED
}

enum FieldVisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Farm {
  id                 String     @id @default(uuid()) @db.Uuid
  organizationId     String     @db.Uuid
  number             Int
  clientId           String     @db.Uuid
  name               String
  registrationNumber String?
  address            String?
  district           String?
  latitude           Decimal?   @db.Decimal(9, 6)
  longitude          Decimal?   @db.Decimal(9, 6)
  areaHectares       Decimal?   @db.Decimal(10, 2)
  notes              String?
  status             FarmStatus @default(ACTIVE)
  createdByName      String?
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  groups       AnimalGroup[]
  animals      Patient[]
  movementsOut LivestockMovement[] @relation("MovementFromFarm")
  movementsIn  LivestockMovement[] @relation("MovementToFarm")
  production   ProductionRecord[]
  treatments   GroupTreatment[]
  outbreaks    DiseaseOutbreak[]
  visits       FieldVisit[]

  @@unique([organizationId, number])
  @@index([organizationId, status, name])
  @@index([clientId])
}

model AnimalGroup {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  farmId            String            @db.Uuid
  name              String
  kind              AnimalGroupKind
  speciesId         String            @db.Uuid
  purpose           ProductionPurpose @default(MIXED)
  /// Batch-level groups (e.g. a poultry flock) track a head count instead of individual animals.
  tracksIndividuals Boolean           @default(true)
  headCount         Int               @default(0)
  initialCount      Int?
  placedOn          DateTime?         @db.Date
  breedText         String?
  location          String?
  notes             String?
  status            AnimalGroupStatus @default(ACTIVE)
  closedAt          DateTime?         @db.Timestamptz(3)
  closedReason      String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farm         Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict)
  species      Species             @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  animals      Patient[]
  movementsOut LivestockMovement[] @relation("MovementFromGroup")
  movementsIn  LivestockMovement[] @relation("MovementToGroup")
  production   ProductionRecord[]
  treatments   GroupTreatment[]
  outbreaks    DiseaseOutbreak[]

  @@unique([farmId, name])
  @@index([organizationId, status])
}

/// Append-only movement and ownership-change history (moves, purchases, sales, deaths, culls, births).
model LivestockMovement {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  type           LivestockEventType
  patientId      String?            @db.Uuid
  fromFarmId     String?            @db.Uuid
  toFarmId       String?            @db.Uuid
  fromGroupId    String?            @db.Uuid
  toGroupId      String?            @db.Uuid
  headCount      Int                @default(1)
  occurredAt     DateTime           @db.Timestamptz(3)
  counterparty   String?
  priceMinor     Int?
  reason         String?
  recordedById   String?            @db.Uuid
  recordedByName String
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  fromFarm     Farm?        @relation("MovementFromFarm", fields: [fromFarmId], references: [id], onDelete: Restrict)
  toFarm       Farm?        @relation("MovementToFarm", fields: [toFarmId], references: [id], onDelete: Restrict)
  fromGroup    AnimalGroup? @relation("MovementFromGroup", fields: [fromGroupId], references: [id], onDelete: Restrict)
  toGroup      AnimalGroup? @relation("MovementToGroup", fields: [toGroupId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt])
  @@index([fromFarmId])
  @@index([toFarmId])
}

/// Breeding and reproduction records. Never edited; a mistaken entry is voided with a reason.
model BreedingEvent {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  patientId       String            @db.Uuid
  type            BreedingEventType
  occurredAt      DateTime          @db.Timestamptz(3)
  sireId          String?           @db.Uuid
  sireText        String?
  semenBatch      String?
  technician      String?
  method          String?
  result          PregnancyResult?
  expectedDueDate DateTime?         @db.Date
  dueDateSource   String?
  offspringCount  Int?
  liveCount       Int?
  notes           String?
  voidedAt        DateTime?         @db.Timestamptz(3)
  voidReason      String?
  voidedByName    String?
  recordedById    String?           @db.Uuid
  recordedByName  String
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation("BreedingFemale", fields: [patientId], references: [id], onDelete: Restrict)
  sire         Patient?     @relation("BreedingSire", fields: [sireId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt(sort: Desc)])
  @@index([organizationId, type, occurredAt])
}

/// Milk, eggs, feed, batch weights and batch mortality. Never edited; corrections void and re-enter.
model ProductionRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  farmId         String         @db.Uuid
  patientId      String?        @db.Uuid
  groupId        String?        @db.Uuid
  kind           ProductionKind
  recordedOn     DateTime       @db.Date
  quantity       Decimal        @db.Decimal(14, 3)
  unit           String
  session        String?
  notes          String?
  voidedAt       DateTime?      @db.Timestamptz(3)
  voidReason     String?
  voidedByName   String?
  recordedById   String?        @db.Uuid
  recordedByName String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  group        AnimalGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([farmId, kind, recordedOn])
  @@index([patientId, recordedOn])
  @@index([groupId, recordedOn])
}

/// Vaccination, parasite-control and treatment campaigns applied to a whole group.
model GroupTreatment {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  farmId             String             @db.Uuid
  groupId            String?            @db.Uuid
  fieldVisitId       String?            @db.Uuid
  kind               GroupTreatmentKind
  productId          String?            @db.Uuid
  productName        String
  batchNumber        String?
  route              String?
  dosePerHead        String?
  headCount          Int
  quantityIssued     Decimal?           @db.Decimal(14, 4)
  administeredAt     DateTime           @db.Timestamptz(3)
  meatClearAt        DateTime?          @db.Timestamptz(3)
  milkClearAt        DateTime?          @db.Timestamptz(3)
  eggClearAt         DateTime?          @db.Timestamptz(3)
  withdrawalSource   String?
  animalsRecorded    Int                @default(0)
  notes              String?
  administeredById   String?            @db.Uuid
  administeredByName String
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  group        AnimalGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  fieldVisit   FieldVisit?  @relation(fields: [fieldVisitId], references: [id], onDelete: Restrict)

  @@index([farmId, administeredAt(sort: Desc)])
  @@index([groupId])
}

model DiseaseOutbreak {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  number                Int
  farmId                String         @db.Uuid
  groupId               String?        @db.Uuid
  disease               String
  notifiable            Boolean        @default(false)
  status                OutbreakStatus @default(SUSPECTED)
  firstSeenOn           DateTime       @db.Date
  confirmedOn           DateTime?      @db.Date
  closedOn              DateTime?      @db.Date
  diagnosisMethod       String?
  populationAtRisk      Int?
  affectedCount         Int            @default(0)
  deathCount            Int            @default(0)
  controlMeasures       String?
  reportedToAuthorityOn DateTime?      @db.Date
  authorityReference    String?
  notes                 String?
  createdByName         String?
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  group        AnimalGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([farmId])
}

model FieldVisit {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  branchId         String           @db.Uuid
  number           Int
  farmId           String           @db.Uuid
  clientId         String           @db.Uuid
  appointmentId    String?          @unique @db.Uuid
  clinicianId      String?          @db.Uuid
  scheduledAt      DateTime         @db.Timestamptz(3)
  purpose          String
  status           FieldVisitStatus @default(SCHEDULED)
  calloutServiceId String?          @db.Uuid
  distanceKm       Decimal?         @db.Decimal(8, 1)
  findings         String?
  recommendations  String?
  startedAt        DateTime?        @db.Timestamptz(3)
  completedAt      DateTime?        @db.Timestamptz(3)
  completedByName  String?
  cancelledAt      DateTime?        @db.Timestamptz(3)
  cancelReason     String?
  createdByName    String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  farm         Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment  Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clinician    Membership?      @relation("FieldVisitClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  items        FieldVisitItem[]
  treatments   GroupTreatment[]

  @@unique([organizationId, number])
  @@index([organizationId, scheduledAt])
  @@index([farmId, scheduledAt])
}

/// Services and products supplied on a field visit; each one is billed as a charge to the farm owner.
model FieldVisitItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  visitId        String   @db.Uuid
  kind           LineKind
  serviceId      String?  @db.Uuid
  productId      String?  @db.Uuid
  patientId      String?  @db.Uuid
  description    String
  quantity       Decimal  @db.Decimal(14, 4)
  unitPriceMinor Int
  recordedByName String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  visit        FieldVisit   @relation(fields: [visitId], references: [id], onDelete: Restrict)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([visitId])
}

