// NextCore VCMS — relational schema.
// Conventions:
//  * UUID primary keys.
//  * Every tenant-owned table carries `organizationId` (enforced by the tenant Prisma extension).
//  * Timestamps are timestamptz (UTC). Money is integer minor units.
//  * Clinical and financial rows are never hard-deleted by application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Platform (multi-clinic hosting) ─────────────────────────────
// Used only in the platform (control) database when BASE_DOMAIN is set: one row per hosted clinic,
// each with its own database. The table exists, empty, in every clinic database too.

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
}

/// A subscription plan the super admin offers: what a clinic may use. Lives in the platform database
/// (the table exists, empty, in clinic databases too). Null limits mean "unlimited".
model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  description       String?
  /// Monthly price in minor units, for the super admin's reference (billing itself is outside the app).
  priceMonthlyMinor Int      @default(0)
  currency          String   @default("PKR") @db.Char(3)
  maxStaff          Int?
  maxBranches       Int?
  /// Feature keys from the plan catalogue (packages/shared/src/plans.ts).
  features          String[] @default([])
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenants Tenant[]
}

model Tenant {
  id                String       @id @default(uuid()) @db.Uuid
  /// Subdomain: <slug>.<BASE_DOMAIN>
  slug              String       @unique
  name              String
  databaseName      String       @unique
  status            TenantStatus @default(PROVISIONING)
  country           String       @db.Char(2)
  branchName        String
  ownerName         String
  ownerEmail        String
  /// TEMPORARY_PASSWORD or INVITATION
  ownerAccess       String
  /// Hash of the owner's temporary password, kept only until the clinic is set up.
  ownerPasswordHash String?
  /// The clinic's organization inside its own database, once set up.
  organizationId    String?      @db.Uuid
  lastError         String?
  provisionedAt     DateTime?    @db.Timestamptz(3)
  suspendedAt       DateTime?    @db.Timestamptz(3)
  createdById       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  /// The clinic's plan; null = no plan assigned (full access, no limits).
  planId              String?   @db.Uuid
  plan                Plan?     @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// Per-clinic exceptions to the plan (null / empty = follow the plan).
  staffLimitOverride  Int?
  branchLimitOverride Int?
  extraFeatures       String[]  @default([])
  removedFeatures     String[]  @default([])
  planChangedAt       DateTime? @db.Timestamptz(3)

  @@index([status])
  @@index([planId])
}

// ───────────────────────────── Tenancy & identity ─────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum BrandFont {
  SYSTEM
  INTER
  ROBOTO
  OPEN_SANS
  LATO
  POPPINS
  NUNITO
  MERRIWEATHER
}

enum CornerStyle {
  SHARP
  STANDARD
  ROUNDED
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum LoginLayout {
  SPLIT
  CENTERED
}

enum LoginBackground {
  MENU_COLOUR
  GRADIENT
  IMAGE
}

enum PrintLogoPosition {
  LEFT
  CENTER
  RIGHT
}

enum PrintSize {
  SMALL
  MEDIUM
  LARGE
}

enum PrintRule {
  BAND
  LINE
  DOUBLE
  NONE
}

model Organization {
  id                          String             @id @default(uuid()) @db.Uuid
  name                        String
  legalName                   String?
  registrationNumber          String?
  taxNumber                   String?
  country                     String             @db.Char(2)
  currency                    String             @db.Char(3)
  defaultTimezone             String
  locale                      String             @default("en")
  email                       String?
  phone                       String?
  website                     String?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  state                       String?
  postcode                    String?
  logoAttachmentId            String?            @db.Uuid
  primaryColor                String?
  /// White label (Settings → Branding, owner only): name in the menu, sign-in page and browser tab; null = clinic name.
  brandName                   String?
  sidebarColor                String?
  /// Square icon for the browser tab; falls back to the logo.
  iconAttachmentId            String?            @db.Uuid
  loginHeadline               String?
  loginMessage                String?
  /// Changes when branding changes, so browsers fetch the new logo and icon.
  brandingUpdatedAt           DateTime?          @db.Timestamptz(3)
  // Branding: look and feel
  brandFont                   BrandFont          @default(SYSTEM)
  cornerStyle                 CornerStyle        @default(STANDARD)
  /// Theme staff get until they choose their own (light / dark / follow the device).
  defaultTheme                ThemeMode          @default(LIGHT)
  /// Logo version for dark backgrounds (dark menu, dark sign-in panel, dark mode).
  logoDarkAttachmentId        String?            @db.Uuid
  // Branding: sign-in page
  loginLayout                 LoginLayout        @default(SPLIT)
  loginBackground             LoginBackground    @default(MENU_COLOUR)
  loginBackgroundAttachmentId String?            @db.Uuid
  loginFooter                 String?
  // Branding: printed documents (letterhead)
  printLogoPosition           PrintLogoPosition  @default(LEFT)
  printHeaderText             String?
  printFooterText             String?
  printUseBrandColour         Boolean            @default(true)
  printLogoSize               PrintSize          @default(MEDIUM)
  printNameSize               PrintSize          @default(MEDIUM)
  printRule                   PrintRule          @default(BAND)
  printShowAddress            Boolean            @default(true)
  printShowContact            Boolean            @default(true)
  printShowTaxNumber          Boolean            @default(true)
  printFooterAlign            PrintLogoPosition  @default(CENTER)
  /// The clinic prints on paper that already has its letterhead: leave the top blank instead of printing one.
  printPreprinted             Boolean            @default(false)
  printTopSpaceMm             Int                @default(40)
  // Branding: emails
  emailSenderName             String?
  emailSignature              String?
  dateFormat                  String             @default("dd/MM/yyyy")
  weightUnit                  String             @default("kg")
  temperatureUnit             String             @default("C")
  disabledModules             String[]           @default([])
  /// Setup checklist: steps the owner chose to skip for now, when the checklist was hidden, and when "Services you offer" was first saved.
  setupSkipped                String[]           @default([])
  setupHiddenAt               DateTime?          @db.Timestamptz(3)
  modulesChosenAt             DateTime?          @db.Timestamptz(3)
  status                      OrganizationStatus @default(ACTIVE)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @db.Timestamptz(3)

  branches                 Branch[]
  memberships              Membership[]
  roles                    Role[]
  counters                 Counter[]
  species                  Species[]
  breeds                   Breed[]
  clients                  Client[]
  addresses                Address[]
  clientContacts           ClientContact[]
  clientNotes              ClientNote[]
  patients                 Patient[]
  patientOwnerships        PatientOwnership[]
  patientIds               PatientIdentifier[]
  weightRecords            WeightRecord[]
  patientAlerts            PatientAlert[]
  attachments              Attachment[]
  appointmentTypes         AppointmentType[]
  resources                Resource[]
  workingHours             WorkingHours[]
  staffLeave               StaffLeave[]
  appointments             Appointment[]
  waitlist                 WaitlistEntry[]
  triage                   TriageAssessment[]
  encounters               Encounter[]
  clinicalNotes            ClinicalNote[]
  vitals                   VitalSign[]
  vitalReferences          VitalReference[]
  diagnoses                Diagnosis[]
  problems                 ProblemListItem[]
  clinicalTemplates        ClinicalTemplate[]
  tasks                    Task[]
  products                 Product[]
  productWithdrawals       ProductWithdrawal[]
  doseReferences           DoseReference[]
  prescriptions            Prescription[]
  prescriptionItems        PrescriptionItem[]
  dispensations            Dispensation[]
  administrations          MedicationAdministration[]
  withdrawals              PatientWithdrawal[]
  labTests                 LabTest[]
  labAnalytes              LabAnalyte[]
  referenceIntervals       ReferenceInterval[]
  diagnosticOrders         DiagnosticOrder[]
  diagnosticItems          DiagnosticOrderItem[]
  samples                  Sample[]
  sampleEvents             SampleEvent[]
  labResults               LabResult[]
  imagingReports           ImagingReport[]
  allowNegativeStock       Boolean                    @default(false)
  pricesIncludeTax         Boolean                    @default(false)
  paymentTermsDays         Int                        @default(0)
  requireCashSession       Boolean                    @default(true)
  /// Purchase orders must be approved by someone other than the person who raised them. Clinics that
  /// existed before this setting keep the rule (migration backfills true); new clinics start without it.
  poRequiresSecondApprover Boolean                    @default(false)
  /// Prescribing screen asks "This is N tablets per dose — is that correct?" above this many countable units
  /// per dose. A data-entry safety prompt, not a dose limit.
  rxConfirmUnitsPerDose    Int                        @default(4)
  stockLocations           StockLocation[]
  stockBatches             StockBatch[]
  stockLevels              StockLevel[]
  stockMovements           StockMovement[]
  stockCounts              StockCount[]
  stockCountLines          StockCountLine[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptLines        GoodsReceiptLine[]
  taxRates                 TaxRate[]
  services                 Service[]
  charges                  Charge[]
  invoices                 Invoice[]
  invoiceLines             InvoiceLine[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  refunds                  Refund[]
  creditNotes              CreditNote[]
  estimates                Estimate[]
  estimateLines            EstimateLine[]
  cashRegisters            CashRegister[]
  cashSessions             CashSession[]
  expenses                 Expense[]
  wards                    Ward[]
  cages                    Cage[]
  admissions               Admission[]
  treatmentOrders          TreatmentOrder[]
  treatmentTasks           TreatmentTask[]
  hospitalNotes            HospitalNote[]
  surgeries                Surgery[]
  surgeryTeamMembers       SurgeryTeamMember[]
  anaesthesiaReadings      AnaesthesiaReading[]
  surgeryItems             SurgeryItem[]
  surgeryAddenda           SurgeryAddendum[]
  surgeryChecklistItems    SurgeryChecklistItem[]
  reminderLeadDays         Int                        @default(14)
  overdueReminderDays      Int                        @default(7)
  appointmentReminderHours Int                        @default(24)
  portalEnabled            Boolean                    @default(true)
  portalCancelHours        Int                        @default(24)
  careProtocols            CareProtocol[]
  careItems                CareItem[]
  messageTemplates         MessageTemplate[]
  outboundMessages         OutboundMessage[]
  clientMessages           ClientMessage[]
  portalAccesses           PortalAccess[]
  appointmentRequests      AppointmentRequest[]

  farms                  Farm[]
  animalGroups           AnimalGroup[]
  livestockMovements     LivestockMovement[]
  breedingEvents         BreedingEvent[]
  productionRecords      ProductionRecord[]
  groupTreatments        GroupTreatment[]
  diseaseOutbreaks       DiseaseOutbreak[]
  fieldVisits            FieldVisit[]
  fieldVisitItems        FieldVisitItem[]
  boardingUnits          BoardingUnit[]
  boardingStays          BoardingStay[]
  boardingLogs           BoardingLog[]
  groomingJobs           GroomingJob[]
  groomingJobServices    GroomingJobService[]
  insuranceProviders     InsuranceProvider[]
  insurancePolicies      InsurancePolicy[]
  preAuthorizations      PreAuthorization[]
  insuranceClaims        InsuranceClaim[]
  insuranceClaimInvoices InsuranceClaimInvoice[]
  referralContacts       ReferralContact[]
  referrals              Referral[]
  purchaseRequests       PurchaseRequest[]
  supplierReturns        SupplierReturn[]
  supplierReturnLines    SupplierReturnLine[]
  productCategories      ProductCategory[]
  receiptSettings        ReceiptSettings?
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  timezone       String
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postcode       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members          MembershipBranch[]
  resources        Resource[]
  appointments     Appointment[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]

  stockLocations StockLocation[]
  invoices       Invoice[]
  cashRegisters  CashRegister[]

  wards      Ward[]
  admissions Admission[]
  surgeries  Surgery[]

  fieldVisits   FieldVisit[]
  boardingUnits BoardingUnit[]
  boardingStays BoardingStay[]
  groomingJobs  GroomingJob[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                         String     @id @default(uuid()) @db.Uuid
  email                      String     @unique
  name                       String
  passwordHash               String?
  isPlatformAdmin            Boolean    @default(false)
  status                     UserStatus @default(ACTIVE)
  mfaEnabled                 Boolean    @default(false)
  mfaSecretEnc               String?
  mfaPendingSecret           String?
  mfaRecoveryHashes          String[]   @default([])
  failedLoginCount           Int        @default(0)
  lockedUntil                DateTime?  @db.Timestamptz(3)
  lastLoginAt                DateTime?  @db.Timestamptz(3)
  passwordChangedAt          DateTime?  @db.Timestamptz(3)
  /// Set when an administrator issues a temporary password: the user must choose their own before doing anything else.
  mustChangePassword         Boolean    @default(false)
  /// A temporary password stops working after this time if it has not been changed.
  temporaryPasswordExpiresAt DateTime?  @db.Timestamptz(3)
  createdAt                  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  authTokens    AuthToken[]
  mfaChallenges MfaChallenge[]
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Membership {
  id                       String           @id @default(uuid()) @db.Uuid
  organizationId           String           @db.Uuid
  userId                   String           @db.Uuid
  status                   MembershipStatus @default(INVITED)
  jobTitle                 String?
  isClinician              Boolean          @default(false)
  professionalRegistration String?
  invitedById              String?          @db.Uuid
  joinedAt                 DateTime?        @db.Timestamptz(3)
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles         MembershipRole[]
  branches      MembershipBranch[]
  workingHours  WorkingHours[]
  leave         StaffLeave[]
  appointments  Appointment[]      @relation("AppointmentClinician")
  encounters    Encounter[]        @relation("EncounterClinician")
  tasks         Task[]             @relation("TaskAssignee")
  prescriptions Prescription[]     @relation("Prescriber")

  responsibleAdmissions Admission[]         @relation("AdmissionClinician")
  surgeryRoles          SurgeryTeamMember[] @relation("SurgeryTeam")

  fieldVisits  FieldVisit[]  @relation("FieldVisitClinician")
  groomingJobs GroomingJob[] @relation("Groomer")

  @@unique([organizationId, userId])
  @@index([userId])
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String?
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
}

model RolePermission {
  roleId     String @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model MembershipRole {
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model MembershipBranch {
  membershipId String @db.Uuid
  branchId     String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([membershipId, branchId])
  @@index([branchId])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  csrfToken      String
  organizationId String?   @db.Uuid
  branchId       String?   @db.Uuid
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt  DateTime  @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  attempts   Int       @default(0)
  ip         String?
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthTokenType {
  PASSWORD_RESET
  INVITATION
}

model AuthToken {
  id             String        @id @default(uuid()) @db.Uuid
  type           AuthTokenType
  tokenHash      String        @unique
  userId         String        @db.Uuid
  organizationId String?       @db.Uuid
  membershipId   String?       @db.Uuid
  expiresAt      DateTime      @db.Timestamptz(3)
  consumedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  branchId       String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actorName      String?
  action         String
  entityType     String
  entityId       String?
  summary        String?
  changes        Json?
  ip             String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorUserId])
}

/// Per-organization sequence numbers (client no., patient no., invoice no. …).
model Counter {
  organizationId String @db.Uuid
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
}

// ───────────────────────────── Species catalogue ─────────────────────────────

enum SpeciesCategory {
  COMPANION
  LIVESTOCK
  POULTRY
  EQUINE
  EXOTIC
  WILDLIFE
}

model Species {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  category       SpeciesCategory
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  breeds             Breed[]
  patients           Patient[]
  vitalRefs          VitalReference[]
  productWithdrawals ProductWithdrawal[]
  doseReferences     DoseReference[]
  referenceIntervals ReferenceInterval[]

  careProtocols CareProtocol[]

  gestationDays   Int?
  gestationSource String?
  animalGroups    AnimalGroup[]

  @@unique([organizationId, name])
}

model Breed {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  speciesId      String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  species      Species      @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  patients     Patient[]

  @@unique([speciesId, name])
  @@index([organizationId])
}

// ───────────────────────────── Clients ─────────────────────────────

enum ClientType {
  INDIVIDUAL
  FAMILY
  FARM
  BREEDER
  COMPANY
  SHELTER
  OTHER
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

enum ContactChannel {
  EMAIL
  SMS
  WHATSAPP
  PHONE
  POST
}

enum ContactRole {
  CO_OWNER
  AUTHORIZED
  EMERGENCY
  BILLING
  OTHER
}

model Client {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  number            Int
  type              ClientType     @default(INDIVIDUAL)
  status            ClientStatus   @default(ACTIVE)
  title             String?
  firstName         String?
  lastName          String?
  organizationName  String?
  /// Denormalised display/sort name ("Surname, First" or business name).
  displayName       String
  email             String?
  mobilePhone       String?
  homePhone         String?
  workPhone         String?
  /// Digits-only copy of mobile phone for duplicate detection and search.
  phoneDigits       String?
  nationalId        String?
  taxNumber         String?
  preferredChannel  ContactChannel @default(SMS)
  preferredLanguage String?
  marketingConsent  Boolean        @default(false)
  remindersConsent  Boolean        @default(true)
  consentUpdatedAt  DateTime?      @db.Timestamptz(3)
  notes             String?
  referralSource    String?
  primaryBranchId   String?        @db.Uuid
  balanceMinor      Int            @default(0)
  mergedIntoId      String?        @db.Uuid
  archivedAt        DateTime?      @db.Timestamptz(3)
  archivedReason    String?
  anonymisedAt      DateTime?      @db.Timestamptz(3)
  createdById       String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addresses        Address[]
  contacts         ClientContact[]
  clientNotes      ClientNote[]
  ownerships       PatientOwnership[]
  appointments     Appointment[]
  waitlist         WaitlistEntry[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]

  charges   Charge[]
  invoices  Invoice[]
  payments  Payment[]
  estimates Estimate[]

  admissions Admission[]
  surgeries  Surgery[]

  clientMessages      ClientMessage[]
  portalAccesses      PortalAccess[]
  appointmentRequests AppointmentRequest[]

  farms             Farm[]
  fieldVisits       FieldVisit[]
  boardingStays     BoardingStay[]
  groomingJobs      GroomingJob[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims   InsuranceClaim[]
  referrals         Referral[]

  @@unique([organizationId, number])
  @@index([organizationId, status, displayName])
  @@index([organizationId, phoneDigits])
  @@index([organizationId, email])
}

model Address {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  label          String?
  line1          String
  line2          String?
  city           String?
  state          String?
  postcode       String?
  country        String   @db.Char(2)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientContact {
  id                    String      @id @default(uuid()) @db.Uuid
  organizationId        String      @db.Uuid
  clientId              String      @db.Uuid
  role                  ContactRole
  name                  String
  relationship          String?
  email                 String?
  phone                 String?
  canAuthorizeTreatment Boolean     @default(false)
  canCollectAnimal      Boolean     @default(false)
  notes                 String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum NoteCategory {
  GENERAL
  COMPLAINT
  FINANCIAL
  COMMUNICATION
}

model ClientNote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  clientId       String       @db.Uuid
  category       NoteCategory @default(GENERAL)
  body           String
  isPinned       Boolean      @default(false)
  authorId       String       @db.Uuid
  authorName     String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt(sort: Desc)])
}

// ───────────────────────────── Patients ─────────────────────────────

enum PatientSex {
  MALE
  FEMALE
  MALE_NEUTERED
  FEMALE_SPAYED
  UNKNOWN
}

enum PatientStatus {
  ACTIVE
  DECEASED
  TRANSFERRED
  ARCHIVED
  MERGED
}

enum IdentifierType {
  MICROCHIP
  EAR_TAG
  RFID
  TATTOO
  BRAND
  REGISTRATION
  OTHER
}

enum AlertType {
  ALLERGY
  CONDITION
  BEHAVIOUR
  MEDICATION
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Patient {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @db.Uuid
  number                Int
  name                  String
  speciesId             String        @db.Uuid
  breedId               String?       @db.Uuid
  breedText             String?
  sex                   PatientSex    @default(UNKNOWN)
  colour                String?
  markings              String?
  dateOfBirth           DateTime?     @db.Date
  dobEstimated          Boolean       @default(false)
  status                PatientStatus @default(ACTIVE)
  deceasedAt            DateTime?     @db.Timestamptz(3)
  causeOfDeath          String?
  euthanasia            Boolean?
  aftercare             String?
  bloodType             String?
  insuranceProvider     String?
  insurancePolicyNumber String?
  notes                 String?
  photoAttachmentId     String?       @db.Uuid
  primaryBranchId       String?       @db.Uuid
  latestWeightKg        Decimal?      @db.Decimal(9, 3)
  mergedIntoId          String?       @db.Uuid
  archivedAt            DateTime?     @db.Timestamptz(3)
  archivedReason        String?
  createdById           String?       @db.Uuid
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  species          Species                    @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  breed            Breed?                     @relation(fields: [breedId], references: [id], onDelete: SetNull)
  ownerships       PatientOwnership[]
  identifiers      PatientIdentifier[]
  weights          WeightRecord[]
  alerts           PatientAlert[]
  appointments     Appointment[]
  waitlist         WaitlistEntry[]
  triage           TriageAssessment[]
  encounters       Encounter[]
  clinicalNotes    ClinicalNote[]
  vitals           VitalSign[]
  diagnoses        Diagnosis[]
  problems         ProblemListItem[]
  tasks            Task[]
  prescriptions    Prescription[]
  administrations  MedicationAdministration[]
  withdrawals      PatientWithdrawal[]
  diagnosticOrders DiagnosticOrder[]

  admissions Admission[]
  surgeries  Surgery[]

  careItems CareItem[]

  farmId  String?      @db.Uuid
  groupId String?      @db.Uuid
  sireId  String?      @db.Uuid
  damId   String?      @db.Uuid
  farm    Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  group   AnimalGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sire    Patient?     @relation("Sire", fields: [sireId], references: [id], onDelete: SetNull)
  dam     Patient?     @relation("Dam", fields: [damId], references: [id], onDelete: SetNull)
  sireOf  Patient[]    @relation("Sire")
  damOf   Patient[]    @relation("Dam")

  livestockMovements LivestockMovement[]
  breedingEvents     BreedingEvent[]     @relation("BreedingFemale")
  sireEvents         BreedingEvent[]     @relation("BreedingSire")
  productionRecords  ProductionRecord[]
  boardingStays      BoardingStay[]
  groomingJobs       GroomingJob[]
  insurancePolicies  InsurancePolicy[]
  insuranceClaims    InsuranceClaim[]
  referrals          Referral[]

  @@unique([organizationId, number])
  @@index([organizationId, status, name])
  @@index([speciesId])
  @@index([farmId])
  @@index([groupId])
}

/// Ownership history. The current legal owner is the row with isPrimary = true and endedAt = null.
/// Co-owners are rows with isPrimary = false and endedAt = null.
model PatientOwnership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  clientId       String    @db.Uuid
  isPrimary      Boolean   @default(true)
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  endedAt        DateTime? @db.Timestamptz(3)
  endReason      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([patientId, endedAt])
  @@index([clientId, endedAt])
}

model PatientIdentifier {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  patientId      String         @db.Uuid
  type           IdentifierType
  value          String
  issuedAt       DateTime?      @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, value])
  @@index([patientId])
  @@index([organizationId, value])
}

model WeightRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  patientId          String   @db.Uuid
  weightKg           Decimal  @db.Decimal(9, 3)
  bodyConditionScore Int?
  bcsScale           Int      @default(9)
  measuredAt         DateTime @default(now()) @db.Timestamptz(3)
  notes              String?
  recordedById       String?  @db.Uuid
  recordedByName     String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, measuredAt(sort: Desc)])
}

model PatientAlert {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  patientId      String        @db.Uuid
  type           AlertType
  severity       AlertSeverity @default(WARNING)
  title          String
  details        String?
  substance      String?
  reaction       String?
  isActive       Boolean       @default(true)
  createdById    String?       @db.Uuid
  createdByName  String?
  resolvedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, isActive])
}

// ───────────────────────────── Files ─────────────────────────────

/// File metadata. Bytes live in the storage adapter (local disk / object storage), never in the database.
model Attachment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  entityType     String
  entityId       String    @db.Uuid
  category       String?
  description    String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String    @unique
  uploadedById   String?   @db.Uuid
  uploadedByName String?
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sharedWithClient Boolean   @default(false)
  sharedAt         DateTime? @db.Timestamptz(3)
  sharedByName     String?

  @@index([organizationId, entityType, entityId])
}

// ───────────────────────────── Scheduling ─────────────────────────────

enum AppointmentCategory {
  CONSULTATION
  VACCINATION
  FOLLOW_UP
  SURGERY
  DENTAL
  DIAGNOSTICS
  GROOMING
  EMERGENCY
  FIELD_VISIT
  OTHER
}

model AppointmentType {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  name               String
  category           AppointmentCategory @default(CONSULTATION)
  durationMinutes    Int                 @default(15)
  color              String              @default("#0d7a70")
  /// Indicative price shown when booking; invoicing uses the service catalogue.
  priceMinor         Int?
  requiresClinician  Boolean             @default(true)
  allowOnlineBooking Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  serviceId String?  @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
}

enum ResourceType {
  ROOM
  THEATRE
  EQUIPMENT
  KENNEL
  VEHICLE
  OTHER
}

model Resource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String       @db.Uuid
  name           String
  type           ResourceType @default(ROOM)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bookings     AppointmentResource[]

  surgeries Surgery[]

  @@unique([branchId, name])
  @@index([organizationId])
}

/// Weekly working pattern. Times are minutes after midnight in the branch's local time.
model WorkingHours {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  branchId       String   @db.Uuid
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, dayOfWeek])
}

enum LeaveType {
  ANNUAL
  SICK
  TRAINING
  PUBLIC_HOLIDAY
  OTHER
}

model StaffLeave {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  membershipId   String    @db.Uuid
  type           LeaveType @default(ANNUAL)
  startsAt       DateTime  @db.Timestamptz(3)
  endsAt         DateTime  @db.Timestamptz(3)
  reason         String?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, startsAt])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  RECEPTION
  PHONE
  ONLINE
  WALK_IN
  FOLLOW_UP
}

enum TriagePriority {
  RESUSCITATION
  EMERGENT
  URGENT
  LESS_URGENT
  NON_URGENT
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  branchId          String            @db.Uuid
  number            Int
  clientId          String            @db.Uuid
  patientId         String?           @db.Uuid
  appointmentTypeId String            @db.Uuid
  clinicianId       String?           @db.Uuid
  startsAt          DateTime          @db.Timestamptz(3)
  endsAt            DateTime          @db.Timestamptz(3)
  status            AppointmentStatus @default(BOOKED)
  source            AppointmentSource @default(RECEPTION)
  priority          TriagePriority?
  reason            String?
  notes             String?
  /// Explicitly permitted double-booking (excluded from the overlap constraint).
  isOverbooked      Boolean           @default(false)
  recurrenceGroupId String?           @db.Uuid
  followUpOfId      String?           @db.Uuid
  confirmedAt       DateTime?         @db.Timestamptz(3)
  checkedInAt       DateTime?         @db.Timestamptz(3)
  startedAt         DateTime?         @db.Timestamptz(3)
  completedAt       DateTime?         @db.Timestamptz(3)
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelReason      String?
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  client          Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  patient         Patient?              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentType AppointmentType       @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  clinician       Membership?           @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  resources       AppointmentResource[]
  triage          TriageAssessment[]
  encounter       Encounter?

  reminderSentAt DateTime? @db.Timestamptz(3)

  fieldVisit  FieldVisit?
  groomingJob GroomingJob?

  @@unique([organizationId, number])
  @@index([organizationId, branchId, startsAt])
  @@index([clinicianId, startsAt])
  @@index([patientId, startsAt])
  @@index([clientId])
}

/// Resource booking. Times are copied from the appointment so the database can reject overlaps.
model AppointmentResource {
  appointmentId String   @db.Uuid
  resourceId    String   @db.Uuid
  startsAt      DateTime @db.Timestamptz(3)
  endsAt        DateTime @db.Timestamptz(3)
  active        Boolean  @default(true)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, resourceId])
  @@index([resourceId, startsAt])
}

enum WaitlistStatus {
  WAITING
  BOOKED
  REMOVED
}

model WaitlistEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  branchId             String         @db.Uuid
  clientId             String         @db.Uuid
  patientId            String?        @db.Uuid
  appointmentTypeId    String?        @db.Uuid
  preferredClinicianId String?        @db.Uuid
  earliestDate         DateTime?      @db.Date
  latestDate           DateTime?      @db.Date
  notes                String?
  status               WaitlistStatus @default(WAITING)
  createdById          String?        @db.Uuid
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  patient         Patient?         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentType AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)

  @@index([organizationId, branchId, status])
}

model TriageAssessment {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  patientId           String         @db.Uuid
  appointmentId       String?        @db.Uuid
  priority            TriagePriority
  presentingComplaint String
  temperatureC        Decimal?       @db.Decimal(4, 1)
  heartRate           Int?
  respiratoryRate     Int?
  mucousMembranes     String?
  capillaryRefillSec  Decimal?       @db.Decimal(3, 1)
  painScore           Int?
  mentation           String?
  notes               String?
  assessedById        String         @db.Uuid
  assessedByName      String
  assessedAt          DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, assessedAt(sort: Desc)])
  @@index([appointmentId])
}

// ───────────────────────────── Clinical records ─────────────────────────────

enum EncounterType {
  CONSULTATION
  EMERGENCY
  FOLLOW_UP
  VACCINATION
  FIELD_VISIT
  TELEHEALTH
  HOSPITAL_ROUND
  OTHER
}

enum EncounterStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String          @db.Uuid
  number         Int
  patientId      String          @db.Uuid
  clientId       String          @db.Uuid
  appointmentId  String?         @unique @db.Uuid
  clinicianId    String?         @db.Uuid
  type           EncounterType   @default(CONSULTATION)
  status         EncounterStatus @default(OPEN)
  chiefComplaint String?
  startedAt      DateTime        @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?       @db.Timestamptz(3)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient          Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client           Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment      Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clinician        Membership?                @relation("EncounterClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  notes            ClinicalNote[]
  vitals           VitalSign[]
  diagnoses        Diagnosis[]
  tasks            Task[]
  prescriptions    Prescription[]
  administrations  MedicationAdministration[]
  diagnosticOrders DiagnosticOrder[]

  @@unique([organizationId, number])
  @@index([patientId, startedAt(sort: Desc)])
  @@index([organizationId, status, startedAt])
}

enum NoteStatus {
  DRAFT
  REVIEWED
  SIGNED
  SUPERSEDED
}

/// SOAP clinical note. Signed notes are immutable; an amendment creates a new version
/// (amendsId → previous) and marks the previous one SUPERSEDED without changing its content.
model ClinicalNote {
  id                   String     @id @default(uuid()) @db.Uuid
  organizationId       String     @db.Uuid
  encounterId          String     @db.Uuid
  patientId            String     @db.Uuid
  version              Int        @default(1)
  status               NoteStatus @default(DRAFT)
  presentingComplaint  String?
  history              String?
  subjective           String?
  objective            String?
  assessment           String?
  plan                 String?
  followUpInstructions String?
  /// Structured physical examination findings: [{ system, status: NORMAL|ABNORMAL|NOT_EXAMINED, notes }].
  examFindings         Json?
  templateId           String?    @db.Uuid
  aiAssisted           Boolean    @default(false)
  authorId             String     @db.Uuid
  authorName           String
  reviewedById         String?    @db.Uuid
  reviewedByName       String?
  reviewedAt           DateTime?  @db.Timestamptz(3)
  signedById           String?    @db.Uuid
  signedByName         String?
  signedAt             DateTime?  @db.Timestamptz(3)
  /// SHA-256 of the signed content, so later tampering is detectable.
  contentHash          String?
  amendsId             String?    @unique @db.Uuid
  amendmentReason      String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  encounter    Encounter     @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  amends       ClinicalNote? @relation("NoteAmendment", fields: [amendsId], references: [id], onDelete: Restrict)
  amendedBy    ClinicalNote? @relation("NoteAmendment")

  @@index([encounterId])
  @@index([patientId, createdAt(sort: Desc)])
}

model VitalSign {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  patientId          String   @db.Uuid
  encounterId        String?  @db.Uuid
  recordedAt         DateTime @default(now()) @db.Timestamptz(3)
  temperatureC       Decimal? @db.Decimal(4, 1)
  heartRate          Int?
  respiratoryRate    Int?
  weightKg           Decimal? @db.Decimal(9, 3)
  mucousMembranes    String?
  capillaryRefillSec Decimal? @db.Decimal(3, 1)
  painScore          Int?
  systolicBp         Int?
  diastolicBp        Int?
  meanBp             Int?
  spo2               Int?
  hydrationPercent   Decimal? @db.Decimal(4, 1)
  notes              String?
  recordedById       String?  @db.Uuid
  recordedByName     String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  admissionId String? @db.Uuid

  @@index([patientId, recordedAt(sort: Desc)])
}

/// Species-specific reference interval for a vital parameter. Must cite a source and be reviewed by a veterinarian.
model VitalReference {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  speciesId      String    @db.Uuid
  parameter      String
  low            Decimal   @db.Decimal(8, 2)
  high           Decimal   @db.Decimal(8, 2)
  unit           String
  source         String
  reviewedByName String?
  reviewedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  species      Species      @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, parameter])
  @@index([organizationId])
}

enum DiagnosisType {
  DIFFERENTIAL
  PROVISIONAL
  CONFIRMED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  RULED_OUT
}

model Diagnosis {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  encounterId     String          @db.Uuid
  patientId       String          @db.Uuid
  term            String
  codeSystem      String?
  code            String?
  type            DiagnosisType   @default(PROVISIONAL)
  status          DiagnosisStatus @default(ACTIVE)
  notes           String?
  diagnosedById   String?         @db.Uuid
  diagnosedByName String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  encounter    Encounter    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt(sort: Desc)])
  @@index([encounterId])
}

enum ProblemStatus {
  ACTIVE
  INACTIVE
  RESOLVED
}

model ProblemListItem {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  patientId         String        @db.Uuid
  term              String
  status            ProblemStatus @default(ACTIVE)
  onsetDate         DateTime?     @db.Date
  resolvedDate      DateTime?     @db.Date
  notes             String?
  isChronic         Boolean       @default(false)
  sourceDiagnosisId String?       @db.Uuid
  createdByName     String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
}

model ClinicalTemplate {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  name                String
  speciesCategory     SpeciesCategory?
  presentingComplaint String?
  subjective          String?
  objective           String?
  assessment          String?
  plan                String?
  examSystems         String[]         @default([])
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
}

enum TaskType {
  HOSPITAL_ALERT
  FOLLOW_UP_CALL
  RECHECK
  RESULT_REVIEW
  CLIENT_CALLBACK
  ADMIN
  OTHER
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @db.Uuid
  branchId        String?    @db.Uuid
  type            TaskType   @default(FOLLOW_UP_CALL)
  status          TaskStatus @default(OPEN)
  title           String
  details         String?
  dueAt           DateTime   @db.Timestamptz(3)
  patientId       String?    @db.Uuid
  clientId        String?    @db.Uuid
  encounterId     String?    @db.Uuid
  assigneeId      String?    @db.Uuid
  completedAt     DateTime?  @db.Timestamptz(3)
  completedByName String?
  createdById     String?    @db.Uuid
  createdByName   String?
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?   @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  assignee     Membership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueAt])
  @@index([assigneeId, status])
}

// ───────────────────────────── Formulary ─────────────────────────────

enum ProductType {
  MEDICINE
  VACCINE
  CONSUMABLE
  RETAIL
  FOOD
  EQUIPMENT
  SUPPLEMENT
  GROOMING
  ACCESSORY
}

enum DosageForm {
  TABLET
  CAPSULE
  ORAL_LIQUID
  ORAL_PASTE
  INJECTION
  INFUSION
  TOPICAL
  OPHTHALMIC
  OTIC
  SPOT_ON
  POUR_ON
  BOLUS
  INTRAMAMMARY
  POWDER
  IMPLANT
  INHALANT
  OTHER
}

/// Catalogue item. Strength is expressed per ONE dispensing unit (e.g. 50 mg per tablet, 10 mg per mL).
model Product {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @db.Uuid
  sku                  String?
  barcode              String?
  name                 String
  genericName          String?
  type                 ProductType       @default(MEDICINE)
  /// Shop shelf group (e.g. "Dry food", "Shampoos & conditioners"); configured per organization.
  categoryId           String?           @db.Uuid
  brand                String?
  /// Pack or size as sold, e.g. "3 kg bag", "400 g can", "Medium".
  packSize             String?
  photoAttachmentId    String?           @db.Uuid
  form                 DosageForm?
  strengthValue        Decimal?          @db.Decimal(14, 4)
  strengthUnit         String?
  dispensingUnit       String            @default("unit")
  minDispenseIncrement Decimal           @default(1) @db.Decimal(10, 4)
  activeIngredients    String[]          @default([])
  /// Drug class / family as entered by the clinic (e.g. "Penicillins", "NSAIDs"); allergy checks match it.
  drugClass            String?
  manufacturer         String?
  requiresPrescription Boolean           @default(true)
  isControlled         Boolean           @default(false)
  controlledSchedule   String?
  targetSpecies        SpeciesCategory[] @default([])
  sellPriceMinor       Int?
  notes                String?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productCategory    ProductCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  withdrawals        ProductWithdrawal[]
  doseReferences     DoseReference[]
  prescriptionItems  PrescriptionItem[]
  administrations    MedicationAdministration[]
  patientWithdrawals PatientWithdrawal[]

  trackStock      Boolean             @default(true)
  reorderLevel    Decimal?            @db.Decimal(14, 4)
  reorderQuantity Decimal?            @db.Decimal(14, 4)
  taxRateId       String?             @db.Uuid
  taxRate         TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  batches         StockBatch[]
  stockLevels     StockLevel[]
  movements       StockMovement[]
  poLines         PurchaseOrderLine[]
  receiptLines    GoodsReceiptLine[]
  countLines      StockCountLine[]

  treatmentOrders TreatmentOrder[]
  surgeryItems    SurgeryItem[]

  careProtocols CareProtocol[]

  groupTreatments GroupTreatment[]
  fieldVisitItems FieldVisitItem[]

  purchaseRequests    PurchaseRequest[]
  supplierReturnLines SupplierReturnLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, type, name])
  @@index([organizationId, categoryId])
}

/// Shop categories for products (food, grooming, accessories…). Deactivate instead of deleting.
model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  /// The product type this category belongs to; products in it must have that type. Null = any type.
  productType    ProductType?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId, productType, sortOrder])
}

/// Withdrawal period for a food-producing species. Must cite the product label or regulatory source.
model ProductWithdrawal {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  speciesId      String   @db.Uuid
  meatDays       Int?
  milkHours      Int?
  eggDays        Int?
  source         String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  species      Species      @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([productId, speciesId])
}

enum DoseReferenceStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// Clinic-maintained dose guidance. Never seeded with clinical values; must cite a source and be
/// approved by a veterinarian before the calculator uses it.
model DoseReference {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  productId      String              @db.Uuid
  speciesId      String              @db.Uuid
  indication     String?
  route          String
  doseMin        Decimal             @db.Decimal(14, 4)
  doseMax        Decimal             @db.Decimal(14, 4)
  /// e.g. mg/kg, mL/kg, IU/kg, mg/animal
  doseUnit       String
  frequency      String?
  maxPerDose     Decimal?            @db.Decimal(14, 4)
  notes          String?
  source         String
  status         DoseReferenceStatus @default(DRAFT)
  createdByName  String?
  approvedById   String?             @db.Uuid
  approvedByName String?
  approvedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  species      Species            @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  items        PrescriptionItem[]

  @@index([productId, speciesId, status])
}

// ───────────────────────────── Prescriptions ─────────────────────────────

enum PrescriptionStatus {
  DRAFT
  AUTHORIZED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model Prescription {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  branchId         String             @db.Uuid
  number           Int
  patientId        String             @db.Uuid
  clientId         String             @db.Uuid
  encounterId      String?            @db.Uuid
  prescriberId     String?            @db.Uuid
  status           PrescriptionStatus @default(DRAFT)
  weightKg         Decimal?           @db.Decimal(9, 3)
  notes            String?
  validUntil       DateTime?          @db.Date
  repeatOfId       String?            @db.Uuid
  authorizedById   String?            @db.Uuid
  authorizedByName String?
  authorizedAt     DateTime?          @db.Timestamptz(3)
  contentHash      String?
  cancelledAt      DateTime?          @db.Timestamptz(3)
  cancelReason     String?
  createdById      String?            @db.Uuid
  createdByName    String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  encounter    Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  prescriber   Membership?        @relation("Prescriber", fields: [prescriberId], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([patientId, createdAt(sort: Desc)])
}

model PrescriptionItem {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  prescriptionId    String   @db.Uuid
  productId         String   @db.Uuid
  route             String
  doseValue         Decimal  @db.Decimal(14, 4)
  doseUnit          String
  weightKgUsed      Decimal? @db.Decimal(9, 3)
  /// Amount per administration in dispensing units, after rounding to the product's increment.
  amountPerDose     Decimal  @db.Decimal(14, 4)
  frequencyPerDay   Decimal? @db.Decimal(6, 3)
  frequencyText     String
  durationDays      Int?
  quantity          Decimal  @db.Decimal(14, 4)
  quantityDispensed Decimal  @default(0) @db.Decimal(14, 4)
  repeats           Int      @default(0)
  instructions      String
  doseReferenceId   String?  @db.Uuid
  /// Safety warnings shown and acknowledged at prescribing time.
  warnings          Json?
  overrideReason    String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  prescription    Prescription               @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product         Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  doseReference   DoseReference?             @relation(fields: [doseReferenceId], references: [id], onDelete: SetNull)
  dispensations   Dispensation[]
  administrations MedicationAdministration[]

  @@index([prescriptionId])
}

model Dispensation {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  prescriptionItemId String    @db.Uuid
  quantity           Decimal   @db.Decimal(14, 4)
  batchNumber        String?
  expiryDate         DateTime? @db.Date
  notes              String?
  dispensedById      String    @db.Uuid
  dispensedByName    String
  dispensedAt        DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)

  @@index([prescriptionItemId])
  @@index([organizationId, dispensedAt])
}

enum AdministrationStatus {
  GIVEN
  NOT_GIVEN
}

model MedicationAdministration {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  patientId          String               @db.Uuid
  encounterId        String?              @db.Uuid
  productId          String               @db.Uuid
  prescriptionItemId String?              @db.Uuid
  status             AdministrationStatus @default(GIVEN)
  dose               Decimal              @db.Decimal(14, 4)
  doseUnit           String
  route              String
  site               String?
  batchNumber        String?
  expiryDate         DateTime?            @db.Date
  reasonNotGiven     String?
  notes              String?
  administeredAt     DateTime             @default(now()) @db.Timestamptz(3)
  administeredById   String               @db.Uuid
  administeredByName String
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter    Encounter?        @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  item         PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)

  @@index([patientId, administeredAt(sort: Desc)])
}

/// Food-safety withdrawal period started by a treatment of a food-producing animal.
model PatientWithdrawal {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  patientId      String    @db.Uuid
  productId      String    @db.Uuid
  sourceType     String
  sourceId       String    @db.Uuid
  treatedAt      DateTime  @db.Timestamptz(3)
  meatClearAt    DateTime? @db.Timestamptz(3)
  milkClearAt    DateTime? @db.Timestamptz(3)
  eggClearAt     DateTime? @db.Timestamptz(3)
  source         String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([patientId, treatedAt(sort: Desc)])
}

// ───────────────────────────── Laboratory & imaging ─────────────────────────────

enum LabCategory {
  HAEMATOLOGY
  BIOCHEMISTRY
  URINALYSIS
  PARASITOLOGY
  MICROBIOLOGY
  CYTOLOGY
  HISTOPATHOLOGY
  SEROLOGY
  ENDOCRINOLOGY
  MOLECULAR
  IMAGING
  OTHER
}

enum SampleType {
  WHOLE_BLOOD_EDTA
  SERUM
  PLASMA
  URINE
  FAECES
  SWAB
  TISSUE
  MILK
  SKIN_SCRAPING
  FLUID
  OTHER
  NONE
}

enum ResultType {
  NUMERIC
  TEXT
  OPTION
}

model LabTest {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  code            String
  name            String
  category        LabCategory
  sampleType      SampleType  @default(NONE)
  /// IN_HOUSE or EXTERNAL
  performedBy     String      @default("IN_HOUSE")
  externalLabName String?
  /// Imaging modality (XRAY, ULTRASOUND, CT, MRI, ENDOSCOPY) for IMAGING tests.
  modality        String?
  priceMinor      Int?
  turnaroundHours Int?
  instructions    String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  analytes     LabAnalyte[]
  orderItems   DiagnosticOrderItem[]

  @@unique([organizationId, code])
}

model LabAnalyte {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  testId         String     @db.Uuid
  code           String
  name           String
  unit           String?
  resultType     ResultType @default(NUMERIC)
  options        String[]   @default([])
  decimals       Int        @default(1)
  sortOrder      Int        @default(0)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  test         LabTest             @relation(fields: [testId], references: [id], onDelete: Cascade)
  intervals    ReferenceInterval[]
  results      LabResult[]

  @@unique([testId, code])
}

/// Species-specific reference interval. Must cite a source (analyser/laboratory/publication).
model ReferenceInterval {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  analyteId      String      @db.Uuid
  speciesId      String      @db.Uuid
  sex            PatientSex?
  ageMinMonths   Int?
  ageMaxMonths   Int?
  low            Decimal?    @db.Decimal(14, 4)
  high           Decimal?    @db.Decimal(14, 4)
  criticalLow    Decimal?    @db.Decimal(14, 4)
  criticalHigh   Decimal?    @db.Decimal(14, 4)
  source         String
  reviewedByName String?
  reviewedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  analyte      LabAnalyte   @relation(fields: [analyteId], references: [id], onDelete: Cascade)
  species      Species      @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([analyteId, speciesId])
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum DiagnosticOrderStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  AWAITING_VALIDATION
  RELEASED
  CANCELLED
}

model DiagnosticOrder {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @db.Uuid
  branchId             String                @db.Uuid
  number               Int
  patientId            String                @db.Uuid
  clientId             String                @db.Uuid
  encounterId          String?               @db.Uuid
  priority             OrderPriority         @default(ROUTINE)
  status               DiagnosticOrderStatus @default(ORDERED)
  clinicalNotes        String?
  externalReference    String?
  hasCritical          Boolean               @default(false)
  orderedById          String                @db.Uuid
  orderedByName        String
  orderingMembershipId String?               @db.Uuid
  releasedById         String?               @db.Uuid
  releasedByName       String?
  releasedAt           DateTime?             @db.Timestamptz(3)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  cancelReason         String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  encounter    Encounter?            @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  items        DiagnosticOrderItem[]
  samples      Sample[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([patientId, createdAt(sort: Desc)])
}

enum OrderItemStatus {
  PENDING
  RESULTED
  CANCELLED
}

model DiagnosticOrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  orderId        String          @db.Uuid
  testId         String          @db.Uuid
  status         OrderItemStatus @default(PENDING)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order         DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test          LabTest         @relation(fields: [testId], references: [id], onDelete: Restrict)
  results       LabResult[]
  imagingReport ImagingReport?

  @@index([orderId])
}

enum SampleStatus {
  COLLECTED
  RECEIVED
  IN_ANALYSIS
  REJECTED
  DISPOSED
}

model Sample {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  orderId         String       @db.Uuid
  barcode         String
  sampleType      SampleType
  status          SampleStatus @default(COLLECTED)
  collectedAt     DateTime     @default(now()) @db.Timestamptz(3)
  collectedById   String       @db.Uuid
  collectedByName String
  rejectionReason String?
  notes           String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events       SampleEvent[]

  @@unique([organizationId, barcode])
  @@index([orderId])
}

/// Chain-of-custody log for a sample.
model SampleEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sampleId       String   @db.Uuid
  action         String
  notes          String?
  byId           String   @db.Uuid
  byName         String
  at             DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sample       Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId, at])
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum ResultStatus {
  PRELIMINARY
  FINAL
  SUPERSEDED
}

/// One analyte value. Reference interval and source are snapshotted at entry time.
/// FINAL results are immutable (DB trigger); corrections create a new row with supersedesId.
model LabResult {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  orderItemId     String       @db.Uuid
  analyteId       String       @db.Uuid
  valueNumeric    Decimal?     @db.Decimal(14, 4)
  valueText       String?
  unit            String?
  refLow          Decimal?     @db.Decimal(14, 4)
  refHigh         Decimal?     @db.Decimal(14, 4)
  refSource       String?
  flag            ResultFlag?
  status          ResultStatus @default(PRELIMINARY)
  comment         String?
  enteredById     String       @db.Uuid
  enteredByName   String
  enteredAt       DateTime     @default(now()) @db.Timestamptz(3)
  supersedesId    String?      @unique @db.Uuid
  amendmentReason String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         DiagnosticOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  analyte      LabAnalyte          @relation(fields: [analyteId], references: [id], onDelete: Restrict)
  supersedes   LabResult?          @relation("ResultAmendment", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy LabResult?          @relation("ResultAmendment")

  @@index([orderItemId, analyteId])
}

model ImagingReport {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  orderItemId      String   @unique @db.Uuid
  modality         String
  bodyRegion       String?
  views            String?
  findings         String
  conclusion       String
  recommendations  String?
  studyInstanceUid String?
  reportedById     String   @db.Uuid
  reportedByName   String
  reportedAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item         DiagnosticOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Inventory ─────────────────────────────

enum LocationType {
  PHARMACY
  STORE
  WARD
  THEATRE
  VEHICLE
  OTHER
}

model StockLocation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String       @db.Uuid
  name           String
  type           LocationType @default(STORE)
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  levels       StockLevel[]
  movements    StockMovement[]
  counts       StockCount[]

  @@unique([branchId, name])
  @@index([organizationId])
}

enum BatchStatus {
  AVAILABLE
  QUARANTINED
  RECALLED
}

model StockBatch {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  productId      String      @db.Uuid
  batchNumber    String
  expiryDate     DateTime?   @db.Date
  /// Cost per dispensing unit (weighted average across receipts of the same batch).
  unitCostMinor  Int         @default(0)
  supplierId     String?     @db.Uuid
  status         BatchStatus @default(AVAILABLE)
  statusReason   String?
  receivedAt     DateTime    @default(now()) @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier     Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  levels       StockLevel[]
  movements    StockMovement[]
  receiptLines GoodsReceiptLine[]
  countLines   StockCountLine[]

  supplierReturnLines SupplierReturnLine[]

  @@unique([productId, batchNumber])
  @@index([organizationId, expiryDate])
}

/// Current quantity of a batch at a location. Always changed together with a StockMovement row.
model StockLevel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  batchId        String   @db.Uuid
  locationId     String   @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch        StockBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([batchId, locationId])
  @@index([productId, locationId])
}

enum MovementType {
  RECEIPT
  DISPENSE
  ADMINISTER
  SALE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT
  WRITE_OFF
  RETURN_TO_SUPPLIER
  RETURN_FROM_CLIENT
}

/// Append-only stock ledger (DB trigger). Quantity is signed: + in, − out.
model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  branchId       String       @db.Uuid
  productId      String       @db.Uuid
  batchId        String       @db.Uuid
  locationId     String       @db.Uuid
  type           MovementType
  quantity       Decimal      @db.Decimal(14, 4)
  balanceAfter   Decimal      @db.Decimal(14, 4)
  unitCostMinor  Int          @default(0)
  reason         String?
  referenceType  String?
  referenceId    String?      @db.Uuid
  createdById    String?      @db.Uuid
  createdByName  String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch        StockBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

enum CountStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model StockCount {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  locationId      String      @db.Uuid
  number          Int
  status          CountStatus @default(OPEN)
  notes           String?
  startedById     String      @db.Uuid
  startedByName   String
  completedById   String?     @db.Uuid
  completedByName String?
  completedAt     DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location     StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines        StockCountLine[]

  @@unique([organizationId, number])
}

model StockCountLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  countId        String   @db.Uuid
  productId      String   @db.Uuid
  batchId        String   @db.Uuid
  expectedQty    Decimal  @db.Decimal(14, 4)
  countedQty     Decimal? @db.Decimal(14, 4)
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  count        StockCount   @relation(fields: [countId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch        StockBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([countId, batchId])
}

// ───────────────────────────── Procurement ─────────────────────────────

model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String
  contactName      String?
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  paymentTermsDays Int      @default(30)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches        StockBatch[]
  purchaseOrders PurchaseOrder[]
  receipts       GoodsReceipt[]
  expenses       Expense[]

  returns SupplierReturn[]

  @@unique([organizationId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  branchId       String              @db.Uuid
  number         Int
  supplierId     String              @db.Uuid
  locationId     String              @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  expectedAt     DateTime?           @db.Date
  notes          String?
  totalMinor     Int                 @default(0)
  createdById    String              @db.Uuid
  createdByName  String
  submittedAt    DateTime?           @db.Timestamptz(3)
  approvedById   String?             @db.Uuid
  approvedByName String?
  approvedAt     DateTime?           @db.Timestamptz(3)
  cancelledAt    DateTime?           @db.Timestamptz(3)
  cancelReason   String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  requests PurchaseRequest[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  purchaseOrderId  String  @db.Uuid
  productId        String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 4)
  unitCostMinor    Int
  quantityReceived Decimal @default(0) @db.Decimal(14, 4)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  GoodsReceiptLine[]
}

model GoodsReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  branchId          String   @db.Uuid
  number            Int
  supplierId        String   @db.Uuid
  purchaseOrderId   String?  @db.Uuid
  locationId        String   @db.Uuid
  supplierInvoiceNo String?
  totalMinor        Int      @default(0)
  notes             String?
  receivedById      String   @db.Uuid
  receivedByName    String
  receivedAt        DateTime @default(now()) @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier      Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@unique([organizationId, number])
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  organizationId      String  @db.Uuid
  goodsReceiptId      String  @db.Uuid
  productId           String  @db.Uuid
  purchaseOrderLineId String? @db.Uuid
  batchId             String  @db.Uuid
  quantity            Decimal @db.Decimal(14, 4)
  unitCostMinor       Int

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  poLine       PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  batch        StockBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
}

// ───────────────────────────── Billing & finance ─────────────────────────────

model TaxRate {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  name            String
  /// Rate × 100 (10% = 1000)
  rateBasisPoints Int
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  services     Service[]
  products     Product[]

  @@unique([organizationId, name])
}

enum ServiceCategory {
  CONSULTATION
  PROCEDURE
  SURGERY
  DIAGNOSTIC
  HOSPITALISATION
  VACCINATION
  DENTAL
  GROOMING
  BOARDING
  FIELD_VISIT
  OTHER
}

model Service {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  code           String
  name           String
  category       ServiceCategory @default(OTHER)
  priceMinor     Int
  taxRateId      String?         @db.Uuid
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taxRate          TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  appointmentTypes AppointmentType[]

  wards     Ward[]
  surgeries Surgery[]

  fieldVisitItems     FieldVisitItem[]
  boardingUnits       BoardingUnit[]
  groomingJobServices GroomingJobService[]

  @@unique([organizationId, code])
}

enum ChargeStatus {
  PENDING
  INVOICED
  WAIVED
}

enum LineKind {
  SERVICE
  PRODUCT
  LAB
  CUSTOM
}

/// A billable event captured once at its source (dispensing, lab order, consultation…).
/// Unique per source so the same event can never be charged twice.
model Charge {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  branchId           String       @db.Uuid
  clientId           String       @db.Uuid
  patientId          String?      @db.Uuid
  encounterId        String?      @db.Uuid
  sourceType         String
  sourceId           String       @db.Uuid
  kind               LineKind
  serviceId          String?      @db.Uuid
  productId          String?      @db.Uuid
  labTestId          String?      @db.Uuid
  description        String
  quantity           Decimal      @db.Decimal(14, 4)
  unitPriceMinor     Int
  taxRateBasisPoints Int          @default(0)
  status             ChargeStatus @default(PENDING)
  invoiceLineId      String?      @unique @db.Uuid
  waivedReason       String?
  createdByName      String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceLine  InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, clientId, status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  branchId         String        @db.Uuid
  /// Assigned when issued so issued invoice numbers are gap-free.
  number           Int?
  clientId         String?       @db.Uuid
  patientId        String?       @db.Uuid
  encounterId      String?       @db.Uuid
  status           InvoiceStatus @default(DRAFT)
  currency         String        @db.Char(3)
  pricesIncludeTax Boolean       @default(false)
  isPos            Boolean       @default(false)
  subtotalMinor    Int           @default(0)
  discountMinor    Int           @default(0)
  taxMinor         Int           @default(0)
  totalMinor       Int           @default(0)
  creditedMinor    Int           @default(0)
  paidMinor        Int           @default(0)
  balanceMinor     Int           @default(0)
  issuedAt         DateTime?     @db.Timestamptz(3)
  dueAt            DateTime?     @db.Timestamptz(3)
  notes            String?
  createdById      String        @db.Uuid
  createdByName    String
  issuedByName     String?
  voidedAt         DateTime?     @db.Timestamptz(3)
  voidedByName     String?
  voidReason       String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  allocations  PaymentAllocation[]
  creditNotes  CreditNote[]

  claimInvoices InsuranceClaimInvoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status, issuedAt])
  @@index([clientId, status])
}

model InvoiceLine {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  invoiceId          String   @db.Uuid
  kind               LineKind
  description        String
  serviceId          String?  @db.Uuid
  productId          String?  @db.Uuid
  labTestId          String?  @db.Uuid
  quantity           Decimal  @db.Decimal(14, 4)
  unitPriceMinor     Int
  discountMinor      Int      @default(0)
  taxRateBasisPoints Int      @default(0)
  netMinor           Int
  taxMinor           Int
  grossMinor         Int
  sortOrder          Int      @default(0)
  /// POS/direct product sale: stock is issued when the invoice is issued.
  stockIssued        Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  charge       Charge?

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  CHEQUE
  ONLINE
  OTHER
  INSURANCE
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  number         Int
  clientId       String?       @db.Uuid
  amountMinor    Int
  method         PaymentMethod
  reference      String?
  idempotencyKey String?
  cashSessionId  String?       @db.Uuid
  refundedMinor  Int           @default(0)
  notes          String?
  receivedById   String        @db.Uuid
  receivedByName String
  receivedAt     DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cashSession  CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]
  refunds      Refund[]

  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([clientId, receivedAt])
}

model PaymentAllocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  paymentId      String   @db.Uuid
  invoiceId      String   @db.Uuid
  amountMinor    Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentId])
}

model Refund {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  number         Int
  paymentId      String        @db.Uuid
  amountMinor    Int
  method         PaymentMethod
  reason         String
  cashSessionId  String?       @db.Uuid
  refundedById   String        @db.Uuid
  refundedByName String
  refundedAt     DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
}

model CreditNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  number         Int
  invoiceId      String   @db.Uuid
  amountMinor    Int
  reason         String
  createdById    String   @db.Uuid
  createdByName  String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, number])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
}

model Estimate {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @db.Uuid
  branchId           String         @db.Uuid
  number             Int
  clientId           String         @db.Uuid
  patientId          String?        @db.Uuid
  status             EstimateStatus @default(DRAFT)
  validUntil         DateTime?      @db.Date
  notes              String?
  subtotalMinor      Int            @default(0)
  taxMinor           Int            @default(0)
  totalMinor         Int            @default(0)
  convertedInvoiceId String?        @db.Uuid
  createdById        String         @db.Uuid
  createdByName      String
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines        EstimateLine[]

  @@unique([organizationId, number])
}

model EstimateLine {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  estimateId         String   @db.Uuid
  kind               LineKind
  description        String
  serviceId          String?  @db.Uuid
  productId          String?  @db.Uuid
  labTestId          String?  @db.Uuid
  quantity           Decimal  @db.Decimal(14, 4)
  unitPriceMinor     Int
  discountMinor      Int      @default(0)
  taxRateBasisPoints Int      @default(0)
  netMinor           Int
  taxMinor           Int
  grossMinor         Int
  sortOrder          Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  estimate     Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model CashRegister {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  branchId       String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions     CashSession[]

  @@unique([branchId, name])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  registerId        String            @db.Uuid
  branchId          String            @db.Uuid
  status            CashSessionStatus @default(OPEN)
  openingFloatMinor Int
  openedById        String            @db.Uuid
  openedByName      String
  openedAt          DateTime          @default(now()) @db.Timestamptz(3)
  expectedCashMinor Int?
  countedCashMinor  Int?
  varianceMinor     Int?
  closedById        String?           @db.Uuid
  closedByName      String?
  closedAt          DateTime?         @db.Timestamptz(3)
  notes             String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
